{
  "$schema": "/Users/billybryant/.config/foxxy-bridge/bridge_config_schema.json",
  "mcpServers": {
    "mapbox": {
      "transport": "http",
      "url": "https://mcp.mapbox.com/mcp",
      "tags": [
        "mapbox",
        "geospatial",
        "api"
      ],
      "enabled": true,
      "log_level": "DEBUG",
